{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "noEmit": true, "skipLibCheck": true,
    "erasableSyntaxOnly": true, "resolveJsonModule": true, "esModuleInterop": true
  }
}
