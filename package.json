{
  "name": "owntake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "node apps/server/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.desktop.json",
    "test": "node scripts/test.mjs",
    "check:docs": "node scripts/docs/check.mjs",
    "test:tooling": "node --test scripts/release/release.test.mjs scripts/docs/check.test.mjs",
    "check": "npm run check:docs && npm run test:tooling && npm run typecheck && npm test && npm run build:desktop && npm run smoke:service",
    "backup": "node scripts/backup.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "package:desktop": "npm run build:desktop && node scripts/release/package.mjs",
    "package:mac": "npm run package:desktop -- --platform darwin",
    "package:windows": "npm run package:desktop -- --platform win32",
    "package:linux": "npm run package:desktop -- --platform linux",
    "smoke:package": "node scripts/release/smoke.mjs",
    "release:assemble": "node scripts/release/assemble.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:service": "node scripts/smoke-service.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/session": "11.1.6",
    "@fastify/sse": "0.6.1",
    "@fastify/static": "10.1.10",
    "@fastify/type-provider-typebox": "6.3.0",
    "fastify": "5.12.8",
    "lru-cache": "11.5.3",
    "naive-ui": "2.45.3",
    "typebox": "1.4.5",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  },
  "main": "apps/desktop/dist/main.mjs",
  "description": "OwnTake — a local personal AI film workbench",
  "author": "OwnTake contributors"
}
