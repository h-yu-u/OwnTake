{
  "name": "owntake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "node apps/server/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "backup": "node scripts/backup.ts"
  },
  "dependencies": {
    "naive-ui": "2.45.3",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
